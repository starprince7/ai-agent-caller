{
  "name": "voice-pipeline-agent-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx agent.ts dev",
    "dev:agent:start": "pnpm pkg set \"scripts.dev=tsx agent.ts dev\"",
    "start": "node ./dist/agent.js",
    "lint": "eslint -f unix \"**/*.ts\"",
    "auth:google": "pnpm build && node ./dist/scripts/googleAuth.js",
    "init:sheets": "pnpm build && node ./dist/scripts/initializeSheets.js",
    "create-test-event": "pnpm build && node ./dist/scripts/creat-event.js",
    "download-files": "tsc && node ./dist/agent.js download-files"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.7",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@livekit/agents": "^1.0.36",
    "@livekit/agents-plugin-deepgram": "^1.0.36",
    "@livekit/agents-plugin-elevenlabs": "^1.0.36",
    "@livekit/agents-plugin-livekit": "^1.0.36",
    "@livekit/agents-plugin-openai": "^1.0.36",
    "@livekit/agents-plugin-silero": "^1.0.36",
    "@livekit/noise-cancellation-node": "^0.1.9",
    "@livekit/rtc-node": "^0.13.24",
    "dotenv": "^16.6.1",
    "google-auth-library": "^9.15.1",
    "googleapis": "^140.0.1",
    "livekit-server-sdk": "^2.15.0",
    "luxon": "^3.7.2",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  }
}
